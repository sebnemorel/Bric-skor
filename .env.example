# Bu dosyayı ".env.local" adıyla kopyala ve kendi Supabase bilgilerini yaz.
# Supabase paneli → Connect (ya da Project Settings → API Keys)
# Sadece "publishable" / "anon" anahtarı kullan; "secret" / "service_role" ASLA buraya yazılmaz.
VITE_SUPABASE_URL=https://PROJE_KODUN.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
